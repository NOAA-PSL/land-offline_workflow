# settings for do_landDA.sh for IMS test case

############################
# if calling from submit_cycle,vars in this section will already be set. Otherwise, need to be set here. 

# exp_name= # experiment name
# THISDATE= # date YYYYMMDDHH
# OUTDIR=/scratch2/BMC/gsienkf/${USER}/cycle_land/${exp_name}/  # temporary directory where experiment is run from
# RES= #FV3 resolution
#export FIXorog= orog file location`
#export TSTUB= # file stub for orography files in $TPATH
              # oro_C${RES} for atm only, oro_C${RES}.mx100 for atm/ocean.

# if calling from submit_cycle.sh, do not change these three:
JEDIWORKDIR=${WORKDIR}/jedi/
LANDDADIR=${CYCLEDIR}/DA_update/  # directory where do_landDA.sh script is 
RSTRDIR=${WORKDIR}/   

############################
# DA options

# DA algorithm and state type being updated
# options: "2DVar", "letkf", "hybenkf"
DAalg=letkf
# TODO: fix this: State being updated: snow or smc(soil moisture content) 
analType=snow

# JEDI input obs. 
# options : IMS, GHCN, MADIS, SFCSNO, SNOCVR_SNOMAD
# Corresponding names in pygfs
# - ims_snow
# - ghcn_snow
# - madis_snow
# - sfcsno
# - snocvr_snomad
OBS_TYPES=("GHCN") #SFCSNO" "GHCN" "IMS")  # format: ("OBS1" "OBS2"...)
# JEDI call type for each obs_type above. options: DA
JEDI_TYPES=("DA") # "DA" "DA")  # format ("DA" "DA"...)
# When call DA in monitor mode (e.g., output O-F for an open-loop), set below to "NO" *and* initiate a non-ensembled snow DA run
export DO_SNOW_ADD_INCREMENTS="YES"

#  DA window lenth. Will generally be the same as the FCSTLEN 
WINLEN=24

#OPTIONAL: overrides. TODO: this may no longer apply
#IMShr= # is assimilating IMS at hour other than 18, specify here.

# this is no longer optional
#export OBSDIR=/scratch4/NCEPDEV/land/data/DA
export OBSDIR=${DATADIR}/DA/

# berr dir
#export BCOV_DIR="/scratch4/NCEPDEV/land/data/DA/bump_snow/"  
export BCOV_DIR="${DATADIR}/DA/bump_snow/"

# IAU related parameters
export DOIAU="NO"        # Enable 4DIAU for control with 3 increments
export IAUFHRS="3,6,9"
export IAU_DELTHRS=6
export IAU_OFFSET=6

export DO_SNOWDA="YES"
export DO_SOILDA="NO"
export DO_LAND_IAU=".false."  #should remain false for now
export LSOIL_INCR=2
export DO_ADD_SOILINC="NO"
