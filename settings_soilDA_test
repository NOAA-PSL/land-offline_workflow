export EXECgfs=${EXECgdas}

# Name of the executable that applies increment to bkg and its namelist template
export APPLY_INCR_EXE="${EXECgdas}/apply_incr.exe"  #gdas_apply_incr.x"
export APPLY_INCR_NML_TMPL="${PARMgdas}/soil/apply_incr_nml.j2"
export TASK_CONFIG_YAML_DET="${PARMgdas}/soil/soil_det_config.yaml.j2"
