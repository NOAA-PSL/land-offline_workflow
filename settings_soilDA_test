export EXECgdas=${LANDDADIR}/GDASApp/build/bin/
export PARMgdas=${LANDDADIR}/GDASApp/parm/
export FIXgdas=${LANDDADIR}/jedi/fv3-jedi/Data

export APRUN_SOILANL='srun -l --export=ALL --hint=nomultithread --distribution=block:block -n 6 --mem=0 --cpus-per-task=1'
export APRUN_SOILLETKFANL='srun -l --export=ALL --hint=nomultithread --distribution=block:block -n 6 --mem=0 --cpus-per-task=1'
