# Settings file for submit_cycle, for running the DA_IMS_test 

# experiment name
export exp_name=letkf
STARTDATE=2019120100
ENDDATE=2019120600

#BASEDIR=/scratch2/BMC/gsienkf/${USER}/ # for PSL staff
BASEDIR=/scratch1/NCEPDEV/da/${USER}/  # for EMC staff
SCRDIR=/scratch1/NCEPDEV/stmp2/Tseganeh.Gichamo/

# temporary directory where experiment is run from
#export WORKDIR=${BASEDIR}/workdir/
export WORKDIR=${SCRDIR}/workdir/

# directory where output is saved
#export OUTDIR=${BASEDIR}/cycle_land/${exp_name}/
export OUTDIR=${SCRDIR}/cycle_land/${exp_name}/

# directory of land-offline_workflow repo
export CYCLEDIR=${BASEDIR}/land-offline_workflow/
############################

# decide if GFSv17
export GFSv17="NO"

# run (true) ensemble. NO for LETKFOI
export do_enkf="YES"

# for LETKF, this is size of ensemble.
# for LETKF-OI pseudo ensemble, or non-ensemble runs use 1 
export ensemble_size=20

# number of tiles and vector size
export num_tiles=6         # 1 for regional
export vector_size=18320   # 1067297 C768

# length of each forecast
export FCSTHR=24
# delta to previous cycle --6 always?
export PCYC_DEL=6

#FV3 resolution
export RES=96   # 768
export NPZ=64   # vertical layers
export ORES=mx100
export TPATH=/scratch2/NCEPDEV/land/data/fix/20231027/C${RES}/
export TSTUB=C${RES}.${ORES}_oro_data # file stub for orography files in $TPATH

# number of cycles to submit in a single job
# on hera in the debug queue 20 is a good number.
export cycles_per_job=1

# DA algorithm options: "letkfoi" , "2DVar", "letkf", "hyb2DenVar"
export DAalg=letkf	#hyb2DenVar       # note hyb2DenVar runs both 2DenVar and letkf

# namelist for do_landDA.sh
# set to "openloop" to not call do_landDA.sh
export DA_config="settings_DA_test"
#export DA_config="openloop"

# if want different DA at different times, list here. 
export DA_config00=${DA_config} 
export DA_config06=${DA_config} 
export DA_config12=${DA_config} 
export DA_config18=${DA_config} 

# directory with initial conditions
# can find some here:
export ICSDIR=${CYCLEDIR}/TESTS/RESTARTS/
#/scratch2/BMC/gsienkf/Clara.Draper/DA_test_cases/land-offline_workflow/DA_test_era5/mem000/restarts/vector/

#forcing options: gdas, gswp3, gefs_ens, era5
export atmos_forc=era5

# settings for ensemble forcing perturbation

# forcing prefix
# gdas: C${RES}_GDAS_forcing_
# era: C${RES}_ERA5_forcing_
export forcing_prefix=C${RES}_ERA5_forcing_
export forcing_dir="/scratch2/NCEPDEV/land/data/forcing/era5/datm/C96/"

export static_file="/scratch2/NCEPDEV/land/data/forcing/era5/static/C96/ufs-land_C96_hr3_static_fields.nc"
export stochy_init_exist="YES"   #YES: init patterns read from cycledir/stochy/restart. NO: initialized from seed
export stochy_init_dir="${CYCLEDIR}/STOCHY/RESTART/"
# export stochy_init_found="NO" 

export perturb_forcing="YES"
export perturb_state="YES" # 

# JEDI nproc--make sure to sync with iolayout
export NPROC_JEDI=6

export NPROC_NOMP=6     # Specify this only if necessary; else calculated by code 

# x y and io layout
export LayX=1
export LayY=1
export IOLayX=1
export IOLayY=1
#
export grid_type=-1         #grid type -1 for fv3 tiles 
export lndp_hscale=120000   #horizontal correlation scale for forcing in m ~120Km
export lndp_vscale=800	    #vertical correlation scale (m)
export lndp_tscale=86400    #temporal decorrelation length (s) ~ 24hr
#
