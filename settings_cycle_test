# Settings file for submit_cycle, for running the DA_IMS_test,
# station snow (e.g., GHCN), or soil (SMAP) DA

# experiment name
export exp_name=2dvar_ims_ghcn_snow_test
STARTDATE=2021120100  #2019120112
ENDDATE=2021120300    #2019120400

#export BASEDIR=/scratch4/BMC/gsienkf/${USER}/noah-mp # for PSL staff
BASEDIR=/scratch3/NCEPDEV/stmp/${USER}/               # EMC

# temporary directory where experiment is run from
export WORKDIR=${BASEDIR}/workdir/

# directory where output is saved
export OUTDIR=${BASEDIR}/cycle_land/${exp_name}/

# directory of land-offline_workflow repo
export HOMEdir="$( cd "$( dirname "${BASH_SOURCE[0]}" )" >/dev/null 2>&1 && pwd )"
############################

# run (true) ensemble. NO for LETKFOI
export do_enkf="NO"

# for LETKF, this is size of ensemble, 1 for non-ensemble runs 
export ens_size=1

# number of tiles
export ntiles=6         # 1 for regional
# vector size (from static file)
export vector_size=18320   # hr3 land vectors C384:272699  C96:18320  C768:1067333 C1152:2381853 (hr2:1067297?)

# length of each forecast
export FCSTHR=24
# delta to previous cycle --6 often, but can be 24
export PCYC_DEL=6

#FV3 resolution
export RES=96   
export NPZ=127   # vertical layers
export ORES=mx100
export TSTUB=C${RES}.${ORES}_oro_data # file stub for orography files in $TPATH

export LEVS=128
export CASE=C96
export CASE_ENS=C48
export OCNRES=100
export FIXorog=/scratch3/NCEPDEV/global/role.glopara/fix/orog/20240917/   #${CASE}/

# number of cycles to submit in a single job
# on hera in the debug queue 20 is a good number.
export cycles_per_job=20

# directory with initial conditions
export ICSDIR=/scratch4/NCEPDEV/land/data/RESTARTS/C${RES}/
#export ICSDIR=${CYCLEDIR}/TESTS/RESTARTS/

# namelist for do_landDA.sh
# set to "openloop" to not call do_landDA.sh
# settings_soilDA_test or settings_snowDA_test depending on DA type
export DA_config="settings_snowDA_test"
#export DA_config="openloop" 

# if want different DA at different times, list here. 
export DA_config00=${DA_config} 
export DA_config06=${DA_config} 
export DA_config12=${DA_config} 
export DA_config18=${DA_config} 

# export NPROC_NOMP=6     # This is calculated by the code--- specify only if necessary 

# x y and io layout
export layout_x=1
export layout_y=1
export io_layout_x="1"
export io_layout_y="1"

#forcing options: gdas, gswp3, gefs_ens, era5
export atmos_forc=era5

#---------- settings for ensemble forcing perturbation
# forcing prefix
# gdas: C${RES}_GDAS_forcing_
export forcing_prefix=ERA5-C${RES}.${ORES}_hr3_datm_    #ERA5-C96.mx100_hr3_datm_2024-12-28.nc
export forcing_dir=/scratch4/NCEPDEV/land/data/ufs-land-driver/datm/ERA5/C${RES}.${ORES}/

export static_file=/scratch4/NCEPDEV/land/data/ufs-land-driver/vector_inputs/C${RES}.${ORES}/ufs-land_C${RES}.${ORES}_hr3_static_fields.nc
export stochy_init_exist="NO"   #YES: init patterns read from cycledir/stochy/restart. NO: initialized from seed
export stochy_init_dir="${HOMEdir}/STOCHY/RESTART/"
# export stochy_init_found="NO" 

export perturb_forcing="YES"
export perturb_state="YES" # 

export grid_type=-1         #grid type -1 for fv3 tiles 
export lndp_hscale=120000   #horizontal correlation scale for forcing in m ~120Km
export lndp_vscale=800	    #vertical correlation scale (m)
export lndp_tscale=86400    #temporal decorrelation length (s) ~ 24hr
#
