#!/bin/bash
#
# Runtime Control Settings for Snow DA Regression Tests
#
# This file defines resource allocation, scheduler settings, and baseline
# directory for snow DA regression tests.
#

# Scheduler selection
export SCHEDULER=${SCHEDULER:-"slurm"}

# Job submission settings
export QUEUE=${QUEUE:-"batch"}
export PROJECT_CODE=${PROJECT_CODE:-"da-cpu"}
export PARTITION=${PARTITION:-"cpu"}

# Snow DA Analysis Resource Allocation
# These values are used by submit_test() in driver.sh

# Number of MPI tasks per node for snow analysis
export NTASKS_SNOWANL=${NTASKS_SNOWANL:-"12"}

# Number of compute nodes for snow analysis
export NODES_SNOWANL=${NODES_SNOWANL:-"2"}

# Memory per node (in GB format)
export MEM_SNOWANL=${MEM_SNOWANL:-"500G"}

# Walltime limit for snow analysis test (HH:MM:SS)
export WALLTIME_SNOWANL=${WALLTIME_SNOWANL:-"00:30:00"}

# OpenMP thread count
export OMP_NUM_THREADS_CY=${OMP_NUM_THREADS_CY:-"1"}

# Baseline and Reference Data
# Path to baseline data for regression test comparison
export HOMEreg=${HOMEreg:-"/scratch4/NCEPDEV/land/data/DA/offline_workflow"}

# Update baseline files after successful test
# Set to "TRUE" to update baseline, "FALSE" to keep existing baseline
export UPDATE_BASELINE=${UPDATE_BASELINE:-"FALSE"}

echo "RT Control Settings for Snow DA Tests:"
echo "  SCHEDULER: ${SCHEDULER}"
echo "  QUEUE: ${QUEUE}"
echo "  PROJECT_CODE: ${PROJECT_CODE}"
echo "  PARTITION: ${PARTITION}"
echo "  NTASKS_SNOWANL: ${NTASKS_SNOWANL}"
echo "  NODES_SNOWANL: ${NODES_SNOWANL}"
echo "  MEM_SNOWANL: ${MEM_SNOWANL}"
echo "  WALLTIME_SNOWANL: ${WALLTIME_SNOWANL}"
echo "  HOMEreg (baseline): ${HOMEreg}"
echo "  UPDATE_BASELINE: ${UPDATE_BASELINE}"
echo ""
