# settings for do_landDA.sh for IMS test case

############################
# if calling from submit_cycle,vars in this section will already be set. Otherwise, need to be set here. 

# exp_name= # experiment name
# THISDATE= # date YYYYMMDDHH
# OUTDIR=/scratch2/BMC/gsienkf/${USER}/cycle_land/${exp_name}/  # temporary directory where experiment is run from
# RES= #FV3 resolution
#export TPATH=
#export TSTUB= # file stub for orography files in $TPATH
              # oro_C${RES} for atm only, oro_C${RES}.mx100 for atm/ocean.

# if calling from submit_cycle.sh, do not change these three:
JEDIWORKDIR=${WORKDIR}/jedi/
LANDDADIR=${CYCLEDIR}/DA_update/  # directory where do_landDA.sh script is 
RSTRDIR=${WORKDIR}/   

############################
# DA options

# DA algorithm and state being updated
# options: "letkfoi" , "2DVar", "letkf"
DAalg=2DVar
# State being updated: snow or smc
analVar=snow

# JEDI input obs. options : IMS, GHCN, SFCSNO, MADIS, SYNTH, SMAP 
OBS_TYPES=("GHCN")   #SMAP")  #"IMS" "GHCN" )   # format: ("OBS1" "OBS2") 
# JEDI call type for each obs_type above. options: DA, HOFX
JEDI_TYPES=("DA")  # "DA" )   # format ("DA" "HOFX")

#  DA window lenth. Will generally be the same as the FCSTLEN 
WINLEN=24

# YAMLS. Options, either:
# 1. "construct" to construct the YAML name, based on requested obs types and their availability 
# 2. enter the desired YAML name (will not test for availability of obs)
YAML_DA=construct  #ghcn_snowanlvar.yaml  #construct
YAML_HOFX=construct

LayX=1
LayY=1
NPROC_JEDI=6

#OPTIONAL: overrides.
#IMShr= # is assimilating IMS at hour other than 18, specify here.
#OBSDIR= # to override default OBSDIR

# keep working dir?
KEEPJEDIDIR="YES"

# OPTIONAL : delete jedi work dirs?
SAVE_IMS="NO"
SAVE_TILE="NO"
SAVE_INCR="NO"
SAVE_ANL="NO"
SAVE_HOFX="NO"

export OBSDIR=/scratch4/NCEPDEV/land/data/DA


# IAU related parameters
export DOIAU="NO"        # Enable 4DIAU for control with 3 increments
export IAUFHRS="3,6,9"
export IAU_FHROT=${IAUFHRS%%,*}
export IAU_DELTHRS=6
export IAU_OFFSET=6
export DOIAU_ENKF=${DOIAU:-"NO"}   # Enable 4DIAU for EnKF ensemble
export IAUFHRS_ENKF="3,6,9"
export IAU_DELTHRS_ENKF=6

export DO_JEDISNOWDA="YES"
#Soil DA and whether it is (land) IAU
export DO_GSISOILDA="YES"
export DO_LAND_IAU=".true."
export LSOIL_INCR=2

export NET=gfs
export RUN=gdas

export LEVS=128
export CASE=C96
export CASE_ENS=C48
export CASE_HIST=C96
export OCNRES=100
export ICERES=100
export COMIN_OBS=${JEDIWORKDIR}  #${OBSDIR}/snow_depth/GHCN/processed_data
export DATA=${JEDIWORKDIR}
export COMOUT_SNOW_ANALYSIS=${OUTDIR}/comout
export COMOUT_CONF=${OUTDIR}/conf
export COMIN_ATMOS_RESTART_PREV=${JEDIWORKDIR}/restarts
export FIXorog=${TPATH}/../
export FIXgfs=/scratch3/NCEPDEV/da/Tseganeh.Gichamo/global-workflow/fix

export EXECgdas=${LANDDADIR}/GDASApp/build/bin/
export PARMgdas=${LANDDADIR}/GDASApp/parm/
export HOMEgfs=/scratch3/NCEPDEV/da/Tseganeh.Gichamo/global-workflow/
export USHgfs=${HOMEgfs}/ush
export SCRgfs=${HOMEgfs}/scripts  #update to dev/scripts
export PARMgfs=${HOMEgfs}/parm
